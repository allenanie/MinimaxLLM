# --- large / regenerable -------------------------------------------------
# No trailing slashes: these are symlinks to the data disk, and a directory-only
# pattern never matches a symlink, so they would show as untracked forever.
.venv
harbor
jobs
results
private
pids
artifacts
__pycache__/
*.pyc
*.log

# --- secrets ---------------------------------------------------------------
.env
*.pem
*.key
credentials.json

# --- prose ------------------------------------------------------------------
# The paper draft and scratch notes stay local. Everything else markdown is
# either documentation we want tracked or a seed artifact that is invalid
# without it (a judge detector IS its rubric.md; a Harbor task needs
# instruction.md).
*.md
!README.md
!agent_notes/**/*.md
!backup/**/*.md
!experiments/**/*.md
certified_harness_opt/

.DS_Store

# --- operational scripts for the other experiment ---------------------------
status.sh
supervise.sh
